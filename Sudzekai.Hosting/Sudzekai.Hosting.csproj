<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Sudzekai.Hosting</PackageId>
    <Version>0.1.0</Version>
    <Authors>Sudzekai</Authors>
    <Description>An AOT-friendly application-hosting library. Builds and runs a host with DI-style service registration (singleton, transient and hosted services), factory-based AOT-safe activation and JSON configuration.</Description>
    <PackageTags>hosting;di;dependency-injection;host;builder;configuration;aot;nativeaot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sudzekai/hosting</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sudzekai/hosting.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sudzekai.Hosting.Abstractions\Sudzekai.Hosting.Abstractions.csproj" />
    <ProjectReference Include="..\Sudzekai.Hosting.Types\Sudzekai.Hosting.Types.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>